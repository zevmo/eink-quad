# Copy to quad.env, then: set -a; . ./quad.env; set +a; python app.py
TZ=America/New_York
QUAD_PORT=8740
QUAD_BIND=127.0.0.1
QUAD_TOKEN=change-me            # the device's token; must match NOTE_TOKEN in firmware/src/secrets.h
QUAD_ADMIN=change-me-too        # opens the settings page: http://127.0.0.1:8740/?k=<this>
QUAD_CONTACT=you@example.com    # sent in the User-Agent to api.weather.gov, which asks for a contact
# Optional
# QUAD_CONFIG=/path/to/config.json
# QUAD_STATE=/path/to/state.json
# QUAD_NOTES_DB=/path/to/notes.db       # a note-box sqlite to show notes from
# QUAD_NOTEBOX_DIR=/path/to/notebox      # where that note box's render.py lives
# CLAUDE_CODE_OAUTH_TOKEN=...            # for the one-line brief (needs the `claude` CLI); turn off llm_brief otherwise

# --- Second device: E1001 lower board (Fox + WSJ tech, favorite scores at game time) ---
# QUAD_MODEL=e1001  QUAD_PORT=8741  QUAD_TOKEN=<e1001 token>  QUAD_CONFIG=config-e1001.json  QUAD_STATE=state-e1001.json
# config-e1001.json: {"layout": "lower", "e1001_home": "lower", "cadence": "windows", "quiet": "22-7",
#                     "teams": ["jets", "mets", "devils", "nets", "navy_fb", "rutgers_bb"],
#                     "live_fast": false, "full_every_min": 1440}
# "e1001_home": "gallery" is the old rotating screensaver. Do not flash firmware for this.
# X-Mode is unchanged: vbat >= 3.80 (or no vbat) stays live and the radio long-polls.
# E1003 config: {"layout": "thirds", "daily_home": true, "cadence": "windows",
#                "content_windows": ["7:30", "12:30", "18:30"], "quiet": "22-7", "full_every_min": 1440}
